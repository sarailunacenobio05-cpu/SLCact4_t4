meta {
  name: 01 - Registro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Luna",
    "email": "luna@gmail.com",
    "password": "Password123"
  }
}

assert {
  res.status: eq 201
  res.body.token: isString
}

script:post-response {
  bru.setVar("token", res.body.token);
}

