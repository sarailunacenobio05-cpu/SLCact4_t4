meta {
  name: 02 - Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "luna@gmail.com",
    "password": "Password123"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

script:post-response {
  bru.setVar("token", res.body.token);
}

