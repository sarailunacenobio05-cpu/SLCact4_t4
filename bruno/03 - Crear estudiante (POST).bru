meta {
  name: 03 - Crear estudiante (POST)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/students
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Ana",
    "lastName": "Lopez",
    "email": "ana.lopez@gmail.com"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
}

script:post-response {
  bru.setVar("studentId", res.body.id);
}
